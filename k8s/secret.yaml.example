# Real Mongo connection string, kept out of the ConfigMap and out of git.
# Copy this file to secret.yaml, fill in the real value, then:
#   kubectl apply -f k8s/secret.yaml
# secret.yaml is gitignored -- never commit it.
apiVersion: v1
kind: Secret
metadata:
  name: locust-secrets
type: Opaque
stringData:
  BENCH_MONGO_URI: "mongodb+srv://user:pass@your-cluster.mongodb.net/?retryWrites=true&w=majority"
